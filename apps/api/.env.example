# ── Serveur ───────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── PostgreSQL ────────────────────────────────────────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_NAME=pyra_data
DB_USER=postgres
DB_PASSWORD=postgres

# ── PgAdmin ───────────────────────────────────────────────────────────────────
PGADMIN_EMAIL=admin@admin.com
PGADMIN_PASSWORD=admin

# ── Auth ──────────────────────────────────────────────────────────────────────
TOKEN_API_ACCESS_EXPIRES_IN=8
BCRYPT_SALT_ROUNDS=10

# ── MinIO — doit correspondre aux valeurs du .env racine ─────────────────────
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=changeme
MINIO_BUCKET_RAW=raw
MINIO_BUCKET_CLEAN=clean
MINIO_BUCKET_CURATED=curated

# ── Airflow — doit correspondre aux valeurs du .env racine ───────────────────
AIRFLOW_URL=http://airflow-webserver:8080
AIRFLOW_USER=api_user
AIRFLOW_PASSWORD=changeme

# ── Python FastAPI ────────────────────────────────────────────────────────────
PYTHON_API_URL=http://python:8000
